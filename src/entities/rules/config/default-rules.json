{
  "fsd": {
    "layers": [
      "app",
      "pages",
      "widgets",
      "features",
      "entities",
      "shared"
    ],
    "boundaries": [
      {
        "from": "entities",
        "allow": [
          "shared"
        ]
      },
      {
        "from": "features",
        "allow": [
          "entities",
          "shared",
          "features"
        ]
      },
      {
        "from": "widgets",
        "allow": [
          "features",
          "entities",
          "shared"
        ]
      },
      {
        "from": "pages",
        "allow": [
          "widgets",
          "features",
          "entities",
          "shared"
        ]
      },
      {
        "from": "app",
        "allow": [
          "pages",
          "widgets",
          "features",
          "entities",
          "shared"
        ]
      }
    ],
    "rules": {
      "no-cross-layer-imports": true,
      "enforce-directory-structure": true,
      "no-private-imports": true,
      "enforce-barrel-exports": true
    }
  },
  "naming": {
    "fileCase": "kebab-case",
    "prefixes": {
      "interface": "I",
      "type": "T",
      "enum": "ENUM_"
    },
    "backend": {
      "typeSuffix": "Backend",
      "fileSuffix": "-backend",
      "interfaceExtension": ".interface.ts"
    },
    "exclusions": {
      "hooks": "^use[A-Z]",
      "nextjs": [
        "page",
        "layout",
        "loading",
        "error",
        "not-found",
        "template",
        "default"
      ],
      "semanticFileSuffixes": [
        "service",
        "api",
        "util",
        "config",
        "types",
        "interface",
        "store",
        "hook",
        "slice",
        "schema",
        "converters",
        "handlers",
        "mock"
      ]
    },
    "suffixes": {
      "schema": ".schema.ts",
      "converters": ".converters.ts",
      "api": ".service.ts",
      "handlers": ".handlers.ts",
      "mock": ".mock.ts",
      "config": ".config.ts"
    }
  },
  "linter": {
    "noConsole": true,
    "noAny": true,
    "strictTyping": true,
    "noEnums": true,
    "eslint": {
      "recommendedPlugins": [
        "eslint-plugin-boundaries",
        "eslint-plugin-unicorn"
      ],
      "filenameCase": {
        "enabled": true,
        "rule": "File names must be kebab-case. Allow semantic suffixes (*.service.ts, *.converters.ts, …), React hooks useX.ts, and framework entry files (page/layout).",
        "pluginRule": "unicorn/filename-case",
        "cases": {
          "kebabCase": true,
          "camelCase": false,
          "pascalCase": false
        },
        "ignore": [
          "^use[A-Z][a-zA-Z]*\\.(ts|tsx)$",
          "^[a-z0-9-]+\\.(service|api|util|config|types|interface|store|hook|slice|schema|converters|handlers|mock)\\.ts$",
          "^[a-z0-9-]+\\.(service|store|api|util|config|hook|slice)\\.(types|interface)\\.ts$",
          "^[a-z0-9-]+-backend\\.interface\\.ts$",
          "^(page|layout|loading|error|not-found|template|default)\\.tsx?$",
          "^(globals|metadata)\\.css$",
          "^\\.[a-z][a-z0-9-]*rc(\\.(js|ts|json))?$",
          "^i18n\\.(init|blocks|checker)\\.ts$",
          "^[a-z0-9-]+\\.context\\.ts$"
        ],
        "template": "src/entities/rules/config/entities/eslint-filename-case.md"
      },
      "namingConvention": {
        "enabled": true,
        "rule": "Interfaces I*, type aliases T* (except ENUM_*), exported primitive consts UPPER_CASE, hooks use* camelCase, functions camelCase|PascalCase.",
        "pluginRule": "@typescript-eslint/naming-convention",
        "prefixes": {
          "interface": "I",
          "type": "T",
          "enum": "ENUM_"
        },
        "overrides": [
          {
            "files": [
              "src/shared/ui/shadcn-ui/**/*.{ts,tsx}",
              "src/shared/ui/custom/**/*.tsx"
            ],
            "disable": [
              "@typescript-eslint/naming-convention",
              "@typescript-eslint/no-explicit-any"
            ]
          },
          {
            "files": ["**/*.d.ts"],
            "disable": ["@typescript-eslint/naming-convention"]
          },
          {
            "files": [
              "**/*.config.{ts,js}",
              "vite.config.ts",
              "tailwind.config.ts"
            ],
            "disable": [
              "@typescript-eslint/no-require-imports",
              "no-console"
            ]
          }
        ],
        "template": "src/entities/rules/config/entities/eslint-naming-convention.md"
      },
      "convertersIsolation": {
        "enabled": true,
        "rule": "Converters must not be imported outside the owning entity; only entities/<name>/api may import entities/<name>/converters (prefer relative ../converters).",
        "noRestrictedImports": {
          "patterns": [
            "**/entities/*/converters",
            "**/entities/*/converters/**",
            "@/entities/*/converters",
            "@/entities/*/converters/**"
          ],
          "message": "Converters are private to the entity. Import only from entities/<name>/api via relative '../converters'. UI must use frontend models from RTK hooks."
        },
        "boundaries": {
          "elements": [
            {
              "type": "entity-converters",
              "pattern": "src/entities/*/converters/**",
              "capture": ["entity"]
            },
            {
              "type": "entity-api",
              "pattern": "src/entities/*/api/**",
              "capture": ["entity"]
            }
          ],
          "allowFrom": [
            {
              "from": "entity-api",
              "allow": ["entity-converters"],
              "sameCapture": "entity"
            }
          ]
        },
        "template": "src/entities/rules/config/entities/eslint-converters-boundary.md"
      },
      "openapiTypesIsolation": {
        "enabled": true,
        "rule": "Raw Api.ts / OpenAPI schema types may be imported only in entities/*/types (as T*Backend). Converters, api, handlers, mock, and UI must not import generated/Api or schema symbols from @/shared/api.",
        "noRestrictedImports": {
          "patterns": [
            "**/shared/api/generated/Api",
            "**/shared/api/generated/Api.ts",
            "@/shared/api/generated/Api"
          ],
          "message": "Raw Api.ts types are allowed only in entities/*/types (*-backend.interface.ts). Alias them as T*Backend and import from ../types."
        },
        "allowIn": [
          "src/entities/**/types/**/*",
          "src/shared/api/generated/**/*"
        ],
        "forbidPublicApiReexport": true,
        "adapterNamingPattern": "^T.+Backend$",
        "template": "src/entities/rules/config/entities/eslint-openapi-types-boundary.md"
      }
    }
  },
  "structure": {
    "model": {
      "baseMaxSize": 3,
      "requiredFiles": [
        "index.ts",
        "types.ts"
      ],
      "subfolders": [
        "config",
        "schema",
        "types",
        "api",
        "converters"
      ],
      "filePattern": "^[a-z0-9-]+\\.(config|types|schema|converters|service)\\.ts$"
    },
    "entities": {
      "requiredFolders": [
        "api",
        "types",
        "schema",
        "converters",
        "ui"
      ],
      "optionalFolders": [
        "handlers",
        "mock"
      ],
      "naming": {
        "schema": "*.schema.ts",
        "converters": "*.converters.ts",
        "api": "*.service.ts",
        "handlers": "*.handlers.ts",
        "mock": "*.mock.ts"
      }
    },
    "converters": {
      "suffix": ".converters.ts",
      "mandatory": true,
      "methodNamingPattern": "^map.+To(Frontend|Backend)$",
      "methodNamingDescription": "Use operation-specific names (mapOrdersToFrontend, mapCreatePromocodeToBackend). Literal mapToFrontend/mapToBackend are not required.",
      "forbiddenLiteralMethods": [
        "mapToFrontend",
        "mapToBackend"
      ],
      "allowedConsumers": [
        "entities/*/api/**",
        "entities/*/converters/**"
      ],
      "forbiddenConsumers": [
        "pages/**",
        "widgets/**",
        "features/**",
        "entities/*/ui/**",
        "shared/ui/**"
      ],
      "forbidPublicReexport": true,
      "forbidBackendDtoInUi": true,
      "rule": "Converters run only in entity API (RTK Query). UI receives frontend domain models already; importing mappers or *Backend types into components is forbidden."
    },
    "pagination": {
      "location": "src/shared/types/pagination.types.ts",
      "request": "IPaginationRequest",
      "response": "IPaginationResponse",
      "frontendListShape": {
        "data": "T[]",
        "total": "number"
      },
      "rule": "UI and RTK Query use IPagination*; backend query/response field names are mapped only inside entity converters."
    },
    "zod": {
      "schemaDir": "schema/",
      "typesDir": "types/",
      "inferLocation": "types",
      "allowMultipleSchemasPerEntity": true,
      "forbidInferInSchemaFiles": true
    },
    "openapi": {
      "generatedDir": "src/shared/api/generated",
      "apiFile": "Api.ts",
      "pathsDir": "src/shared/api/generated/paths",
      "adapterFilePattern": "*-backend.interface.ts",
      "adapterTypePattern": "^T.+Backend$",
      "rawTypesOnlyIn": [
        "shared/api/generated/**",
        "entities/*/types/**"
      ],
      "rule": "OpenAPI schema types → T*Backend in entity types only; converters/api use aliases + PATHS."
    }
  },
  "styles": {
    "allowedUtilityPrefixes": [
      "bg-",
      "text-",
      "border-",
      "p-",
      "m-",
      "gap-",
      "flex-",
      "grid-"
    ],
    "forbiddenColors": [
      "slate",
      "gray",
      "zinc",
      "neutral",
      "stone",
      "red",
      "orange",
      "amber",
      "yellow",
      "lime",
      "green",
      "emerald",
      "teal",
      "cyan",
      "sky",
      "blue",
      "indigo",
      "violet",
      "purple",
      "fuchsia",
      "pink",
      "rose"
    ],
    "requiredUtility": "cn"
  },
  "patterns": {
    "stateManagement": {
      "server": "RTK Query (base.api.ts)",
      "client": "Redux Toolkit (slices)",
      "local": "useState"
    },
    "rtkQuery": {
      "location": "src/entities/[entity-name]/api",
      "requiredFiles": [
        "index.ts",
        "*.service.ts"
      ],
      "locationRequiredFiles": {
        "tagsConfig": "src/shared/api/backend/tags.config.ts",
        "baseApi": "src/shared/api/backend/base.api.ts",
        "backendIndex": "src/shared/api/backend/index.ts",
        "authBaseQuery": "src/entities/auth/api/auth-base-query.ts",
        "authApi": "src/entities/auth/api/auth.api.ts",
        "authIndex": "src/entities/auth/api/index.ts",
        "service": "src/entities/[entity-name]/api/[entity-name].service.ts",
        "serviceIndex": "src/entities/[entity-name]/api/index.ts"
      },
      "template": "src/entities/rules/config/entities/api-pattern.md",
      "description": "Паттерн работы с RTK Query: Code Splitting через injectEndpoints, централизованные теги и семантическое переименование в UI.",
      "segments": [
        "Base API",
        "Injected Endpoints",
        "Automatic Selectors"
      ]
    },
    "ui": {
      "composition": {
        "widgets": [
          "features",
          "entities"
        ]
      },
      "responsibility": {
        "entities": "presentation",
        "features": "interactivity"
      },
      "dataBoundary": {
        "consumes": "frontend-domain-models",
        "forbiddenImports": [
          "**/converters/**",
          "map*ToFrontend",
          "map*ToBackend",
          "*Backend"
        ],
        "rule": "UI receives frontend objects from RTK Query hooks. Converters and backend DTOs stay in entities/*/api."
      }
    },
    "i18n": {
      "location": "src/shared/config/i18n",
      "requiredFiles": [
        "index.ts",
        "i18n.init.ts",
        "i18n.config.ts",
        "i18n.blocks.ts",
        "i18n.types.ts",
        "i18n-key.ts",
        "change-language.ts",
        "i18n.checker.ts"
      ],
      "runtimes": {
        "vite": {
          "library": "react-i18next",
          "hook": "useTranslation",
          "richText": "Trans",
          "messagesDir": "public/locales/[lng]",
          "initFile": "i18n.init.ts"
        },
        "next": {
          "library": "next-intl",
          "hook": "useTranslations",
          "richText": "t.rich",
          "messagesDir": "messages/[lng]",
          "initFile": "shared/i18n/request.ts (getRequestConfig)"
        }
      },
      "jsonImportStyle": "import type",
      "template": "src/entities/rules/config/i18n-pattern.md",
      "description": "Строгая i18n с типизацией ключей. Vite → react-i18next + public/locales; Next → next-intl + messages/. JSON эталоны — import type."
    },
    "converters": {
      "location": "src/entities/[entity-name]/converters",
      "requiredFiles": [
        "index.ts",
        "*.converters.ts"
      ],
      "locationRequiredFiles": {
        "converters": "src/entities/[entity-name]/converters/[entity-name].converters.ts",
        "types": "src/entities/[entity-name]/types/[entity-name]-backend.interface.ts",
        "pagination": "src/shared/types/pagination.types.ts"
      },
      "methodNamingPattern": "^map.+To(Frontend|Backend)$",
      "pagination": {
        "request": "IPaginationRequest",
        "response": "IPaginationResponse",
        "listMapping": "Map backend list envelopes to { data, total } in converters, not in UI components.",
        "queryMapping": "Map IPaginationRequest to backend-specific query fields (e.g. elements_on_page) in converters."
      },
      "uiBoundary": {
        "allowedConsumers": [
          "entities/*/api/**",
          "entities/*/converters/**"
        ],
        "forbiddenConsumers": [
          "pages/**",
          "widgets/**",
          "features/**",
          "entities/*/ui/**",
          "shared/ui/**"
        ],
        "forbidConverterImportsInUi": true,
        "forbidMapperNamedImportsInUi": true,
        "forbidBackendDtoTypesInUi": true,
        "forbidPublicApiReexport": true,
        "rationale": "RTK Query already returns frontend models after transformResponse. Components must not re-map DTO or import converters."
      },
      "template": "src/entities/rules/config/entities/converters-pattern.md",
      "description": "Паттерн маппинга DTO↔Domain только в entity API. Запрет импорта converters/map* и *Backend типов в pages/widgets/features/ui."
    },
    "msw": {
      "location": "src/entities/[entity-name]/handlers",
      "requiredFiles": [
        "index.ts",
        "*.handlers.ts"
      ],
      "locationRequiredFiles": {
        "init": "src/app/init/msw.ts",
        "browser": "src/shared/api/msw/browser.ts",
        "server": "src/shared/api/msw/server.ts",
        "utils": "src/shared/api/msw/utils.ts",
        "handlersRegistry": "src/shared/api/msw/handlers.ts",
        "handlers": "src/entities/[entity-name]/handlers/[entity-name].handlers.ts",
        "handlersIndex": "src/entities/[entity-name]/handlers/index.ts",
        "mock": "src/entities/[entity-name]/mock/[entity-name].mock.ts",
        "mockIndex": "src/entities/[entity-name]/mock/index.ts"
      },
      "optionalFiles": {
        "store": "src/entities/[entity-name]/mock/[entity-name].store.ts"
      },
      "rules": {
        "responseShape": "backend-dto",
        "useCreateMockHandler": true,
        "baseUrlEnv": "VITE_BASE_URL",
        "statefulStore": "optional-for-mutations",
        "nodeServerForVitest": true
      },
      "template": "src/entities/rules/config/entities/msw-pattern.md",
      "description": "Контрактные MSW-моки: createMockHandler + VITE_BASE_URL, backend DTO в ответах, опциональный mock store с reset, browser worker и Node server для Vitest."
    },
    "pagination": {
      "location": "src/shared/types/pagination.types.ts",
      "requiredExports": [
        "IPaginationRequest",
        "IPaginationResponse"
      ],
      "frontendListShape": {
        "data": "T[]",
        "total": "number"
      },
      "rules": {
        "uiUsesFrontendShapeOnly": true,
        "backendFieldNamesInConvertersOnly": true,
        "mswReturnsBackendEnvelope": true
      },
      "template": "src/entities/rules/config/entities/pagination-pattern.md",
      "description": "Единый frontend-контракт списков: IPaginationRequest / IPaginationResponse. Backend query и envelope мапятся в entity converters."
    },
    "openapi": {
      "location": "src/shared/api/generated",
      "scripts": {
        "codegen:types": "tsx --env-file=.env scripts/generate-api-types.ts",
        "codegen:paths": "tsx --env-file=.env scripts/generate-api-paths.ts",
        "codegen": "npm run codegen:types && npm run codegen:paths"
      },
      "outputs": {
        "apiTypes": "src/shared/api/generated/Api.ts",
        "paths": "src/shared/api/generated/paths/<tag>.paths.ts"
      },
      "adapter": {
        "location": "src/entities/[entity-name]/types/[entity-name]-backend.interface.ts",
        "namingPattern": "^T.+Backend$",
        "rule": "Raw OpenAPI/Api.ts schema types are aliased to T*Backend only here."
      },
      "importBoundary": {
        "rawApiTypesAllowedIn": [
          "src/shared/api/generated/**",
          "src/entities/*/types/**"
        ],
        "rawApiTypesForbiddenIn": [
          "src/entities/*/api/**",
          "src/entities/*/converters/**",
          "src/entities/*/ui/**",
          "src/entities/*/handlers/**",
          "src/entities/*/mock/**",
          "src/features/**",
          "src/widgets/**",
          "src/pages/**",
          "src/shared/ui/**"
        ],
        "pathsAllowedIn": [
          "src/entities/*/api/**",
          "src/entities/*/handlers/**",
          "src/entities/*/types/**",
          "src/shared/api/**"
        ],
        "forbidPublicApiReexport": true,
        "rationale": "Api.ts is codegen raw material. Domain code uses T*Backend from entity types; PATHS descriptors are allowed in api/handlers."
      },
      "eslint": {
        "enforceVia": [
          "no-restricted-imports",
          "overrides-allow-entity-types"
        ],
        "template": "src/entities/rules/config/entities/eslint-openapi-types-boundary.md"
      },
      "template": "src/entities/rules/config/entities/openapi-pattern.md",
      "description": "OpenAPI codegen (Api.ts + paths) and strict T*Backend adapter: raw schema types only in entities/*/types."
    },
    "theme": {
      "location": "src/app/providers/theme",
      "requiredFiles": [
        "index.ts",
        "theme.provider.tsx",
        "with-theme.tsx"
      ],
      "locationRequiredFiles": {
        "provider": "src/app/providers/theme/theme.provider.tsx",
        "providerIndex": "src/app/providers/theme/index.ts",
        "toggle": "src/shared/ui/layout/theme-toggle/ui/theme-toggle.tsx",
        "toggleIndex": "src/shared/ui/layout/theme-toggle/index.ts",
        "context": "src/shared/ui/layout/theme-toggle/model/theme.context.ts",
        "hook": "src/shared/ui/layout/theme-toggle/model/useTheme.tsx"
      },
      "template": "src/entities/rules/config/theme-pattern.md",
      "description": "Паттерн переключения тем (Light/Dark). Обязательное использование ThemeProvider и useTheme для управления состоянием и синхронизации с DOM."
    },
    "styles": {
      "location": "src/shared/styles",
      "requiredFiles": [
        "global.css",
        "variables.css",
        "theme.css"
      ],
      "locationRequiredFiles": {
        "global": "src/shared/styles/global.css",
        "variables": "src/shared/styles/variables.css",
        "theme": "src/shared/styles/theme.css",
        "config": "tailwind.config.ts"
      },
      "template": "src/entities/rules/config/entities/styles-pattern.md",
      "description": "Паттерн работы с дизайн-токенами и Tailwind CSS. Строгий запрет на хардкод цветов и использование стандартных палитр Tailwind."
    },
    "zod": {
      "location": "src/entities/[entity-name]/schema",
      "requiredFiles": [
        "index.ts",
        "*.schema.ts"
      ],
      "locationRequiredFiles": {
        "schema": "src/entities/[entity-name]/schema/[entity-name]-create.schema.ts",
        "types": "src/entities/[entity-name]/types/[entity-name]-form.types.ts"
      },
      "rules": {
        "schemaContainsRuntimeOnly": true,
        "inferTypesInTypesFolder": true,
        "formEnumsInTypesFolder": true,
        "allowMultipleSchemasPerEntity": true,
        "forbidZInferInSchemaFiles": true
      },
      "template": "src/entities/rules/config/entities/zod-pattern.md",
      "description": "Паттерн валидации через Zod: schema/ — только runtime-схемы; types/ — ENUM_FORM_* и z.infer. Допускается несколько схем на сущность (create/update/delete)."
    },
    "errorBoundary": {
      "location": "src/shared/ui/error-boundary",
      "requiredFiles": [
        "index.ts",
        "error-boundary.tsx",
        "with-error-boundary.tsx"
      ],
      "locationRequiredFiles": {
        "component": "src/shared/ui/error-boundary/error-boundary.tsx",
        "hoc": "src/shared/ui/error-boundary/with-error-boundary.tsx",
        "index": "src/shared/ui/error-boundary/index.ts"
      },
      "template": "src/entities/rules/config/error-boundary-pattern.md",
      "description": "Паттерн перехвата и изоляции ошибок UI. Обязательное использование ErrorBoundary и withErrorBoundary для нестабильных блоков и фичей."
    }
  }
}