{
  "location": "src/shared/config/i18n",
  "requiredFiles": [
    "index.ts",
    "i18n.init.ts",
    "i18n.config.ts",
    "i18n.blocks.ts",
    "i18n.types.ts",
    "i18n-key.ts",
    "change-language.ts",
    "i18n.checker.ts"
  ],
  "runtimes": {
    "vite": {
      "library": "react-i18next",
      "hook": "useTranslation",
      "richText": "Trans",
      "messagesDir": "public/locales/[lng]",
      "initFile": "i18n.init.ts",
      "examples": ["blogix-admin", "tourfirm"]
    },
    "next": {
      "library": "next-intl",
      "hook": "useTranslations",
      "richText": "t.rich",
      "messagesDir": "messages/[lng]",
      "initFile": "shared/i18n/request.ts (getRequestConfig)",
      "examples": ["blogix", "tourfirm-dmc", "tourfirm-dmc-feature-new"]
    }
  },
  "jsonImportStyle": "import type",
  "template": "src/entities/rules/config/i18n-pattern.md",
  "description": "Строгая i18n с типизацией ключей. Vite → react-i18next + public/locales; Next → next-intl + messages/. JSON эталоны — import type."
}
