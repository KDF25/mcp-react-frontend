{
  "location": "src/entities/[entity-name]/handlers",
  "requiredFiles": [
    "index.ts",
    "*.handlers.ts"
  ],
  "locationRequiredFiles": {
    "init": "src/app/init/msw.ts",
    "browser": "src/shared/api/msw/browser.ts",
    "server": "src/shared/api/msw/server.ts",
    "utils": "src/shared/api/msw/utils.ts",
    "handlersRegistry": "src/shared/api/msw/handlers.ts",
    "handlers": "src/entities/[entity-name]/handlers/[entity-name].handlers.ts",
    "handlersIndex": "src/entities/[entity-name]/handlers/index.ts",
    "mock": "src/entities/[entity-name]/mock/[entity-name].mock.ts",
    "mockIndex": "src/entities/[entity-name]/mock/index.ts"
  },
  "optionalFiles": {
    "store": "src/entities/[entity-name]/mock/[entity-name].store.ts"
  },
  "rules": {
    "responseShape": "backend-dto",
    "useCreateMockHandler": true,
    "baseUrlEnv": "VITE_BASE_URL",
    "statefulStore": "optional-for-mutations",
    "nodeServerForVitest": true
  },
  "template": "msw-pattern",
  "description": "Контрактные MSW-моки: createMockHandler + VITE_BASE_URL, backend DTO в ответах, опциональный mock store с reset, browser worker и Node server для Vitest."
}
