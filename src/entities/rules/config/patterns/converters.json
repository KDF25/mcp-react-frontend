{
  "location": "src/entities/[entity-name]/converters",
  "requiredFiles": [
    "index.ts",
    "*.converters.ts"
  ],
  "locationRequiredFiles": {
    "converters": "src/entities/[entity-name]/converters/[entity-name].converters.ts",
    "types": "src/entities/[entity-name]/types/[entity-name]-backend.interface.ts",
    "pagination": "src/shared/types/pagination.types.ts"
  },
  "methodNamingPattern": "^map.+To(Frontend|Backend)$",
  "pagination": {
    "request": "IPaginationRequest",
    "response": "IPaginationResponse",
    "listMapping": "Map backend list envelopes to { data, total } in converters, not in UI components.",
    "queryMapping": "Map IPaginationRequest to backend-specific query fields (e.g. elements_on_page) in converters."
  },
  "uiBoundary": {
    "allowedConsumers": [
      "entities/*/api/**",
      "entities/*/converters/**"
    ],
    "forbiddenConsumers": [
      "pages/**",
      "widgets/**",
      "features/**",
      "entities/*/ui/**",
      "shared/ui/**"
    ],
    "forbidConverterImportsInUi": true,
    "forbidMapperNamedImportsInUi": true,
    "forbidBackendDtoTypesInUi": true,
    "forbidPublicApiReexport": true,
    "rationale": "RTK Query already returns frontend models after transformResponse. Components must not re-map DTO or import converters."
  },
  "eslint": {
    "enforceVia": [
      "no-restricted-imports",
      "eslint-plugin-boundaries"
    ],
    "template": "eslint-converters-boundary",
    "allowedImportStyle": "relative-from-same-entity-api",
    "forbiddenImportStyle": "@/entities/*/converters"
  },
  "template": "converters-pattern",
  "relatedDocs": ["entity-pattern"],
  "description": "Паттерн маппинга DTO↔Domain только в entity API. Запрет импорта converters/map* и *Backend типов в UI; ESLint gate через no-restricted-imports + boundaries."
}
