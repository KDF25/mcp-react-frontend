{
  "noConsole": true,
  "noAny": true,
  "strictTyping": true,
  "noEnums": true,
  "eslint": {
    "recommendedPlugins": [
      "eslint-plugin-boundaries",
      "eslint-plugin-unicorn"
    ],
    "filenameCase": {
      "enabled": true,
      "rule": "File names must be kebab-case. Allow semantic suffixes (*.service.ts, *.converters.ts, …), React hooks useX.ts, and framework entry files (page/layout).",
      "pluginRule": "unicorn/filename-case",
      "cases": {
        "kebabCase": true,
        "camelCase": false,
        "pascalCase": false
      },
      "ignore": [
        "^use[A-Z][a-zA-Z]*\\.(ts|tsx)$",
        "^[a-z0-9-]+\\.(service|api|util|config|types|interface|store|hook|slice|schema|converters|handlers|mock)\\.ts$",
        "^[a-z0-9-]+\\.(service|store|api|util|config|hook|slice)\\.(types|interface)\\.ts$",
        "^[a-z0-9-]+-backend\\.interface\\.ts$",
        "^(page|layout|loading|error|not-found|template|default)\\.tsx?$",
        "^(globals|metadata)\\.css$",
        "^\\.[a-z][a-z0-9-]*rc(\\.(js|ts|json))?$",
        "^i18n\\.(init|blocks|checker)\\.ts$",
        "^[a-z0-9-]+\\.context\\.ts$"
      ],
      "template": "src/entities/rules/config/entities/eslint-filename-case.md"
    },
    "namingConvention": {
      "enabled": true,
      "rule": "Interfaces I*, type aliases T* (except ENUM_*), exported primitive consts UPPER_CASE, hooks use* camelCase, functions camelCase|PascalCase.",
      "pluginRule": "@typescript-eslint/naming-convention",
      "prefixes": {
        "interface": "I",
        "type": "T",
        "enum": "ENUM_"
      },
      "overrides": [
        {
          "files": [
            "src/shared/ui/shadcn-ui/**/*.{ts,tsx}",
            "src/shared/ui/custom/**/*.tsx"
          ],
          "disable": [
            "@typescript-eslint/naming-convention",
            "@typescript-eslint/no-explicit-any"
          ]
        },
        {
          "files": ["**/*.d.ts"],
          "disable": ["@typescript-eslint/naming-convention"]
        },
        {
          "files": [
            "**/*.config.{ts,js}",
            "vite.config.ts",
            "tailwind.config.ts"
          ],
          "disable": [
            "@typescript-eslint/no-require-imports",
            "no-console"
          ]
        }
      ],
      "template": "src/entities/rules/config/entities/eslint-naming-convention.md"
    },
    "convertersIsolation": {
      "enabled": true,
      "rule": "Converters must not be imported outside the owning entity; only entities/<name>/api may import entities/<name>/converters (prefer relative ../converters).",
      "noRestrictedImports": {
        "patterns": [
          "**/entities/*/converters",
          "**/entities/*/converters/**",
          "@/entities/*/converters",
          "@/entities/*/converters/**"
        ],
        "message": "Converters are private to the entity. Import only from entities/<name>/api via relative '../converters'. UI must use frontend models from RTK hooks."
      },
      "boundaries": {
        "elements": [
          {
            "type": "entity-converters",
            "pattern": "src/entities/*/converters/**",
            "capture": ["entity"]
          },
          {
            "type": "entity-api",
            "pattern": "src/entities/*/api/**",
            "capture": ["entity"]
          }
        ],
        "allowFrom": [
          {
            "from": "entity-api",
            "allow": ["entity-converters"],
            "sameCapture": "entity"
          }
        ]
      },
      "template": "src/entities/rules/config/entities/eslint-converters-boundary.md"
    },
    "openapiTypesIsolation": {
      "enabled": true,
      "rule": "Raw Api.ts / OpenAPI schema types may be imported only in entities/*/types (as T*Backend). Converters, api, handlers, mock, and UI must not import generated/Api or schema symbols from @/shared/api.",
      "noRestrictedImports": {
        "patterns": [
          "**/shared/api/generated/Api",
          "**/shared/api/generated/Api.ts",
          "@/shared/api/generated/Api"
        ],
        "message": "Raw Api.ts types are allowed only in entities/*/types (*-backend.interface.ts). Alias them as T*Backend and import from ../types."
      },
      "allowIn": [
        "src/entities/**/types/**/*",
        "src/shared/api/generated/**/*"
      ],
      "forbidPublicApiReexport": true,
      "adapterNamingPattern": "^T.+Backend$",
      "template": "src/entities/rules/config/entities/eslint-openapi-types-boundary.md"
    }
  }
}
