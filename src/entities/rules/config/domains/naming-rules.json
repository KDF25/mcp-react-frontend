{
  "fileCase": "kebab-case",
  "prefixes": {
    "interface": "I",
    "type": "T",
    "enum": "ENUM_"
  },
  "backend": {
    "typeSuffix": "Backend",
    "fileSuffix": "-backend",
    "interfaceExtension": ".interface.ts",
    "typeKind": "type",
    "typePattern": "^T.+Backend$"
  },
  "exclusions": {
    "hooks": "^use[A-Z]",
    "nextjs": [
      "page",
      "layout",
      "loading",
      "error",
      "not-found",
      "template",
      "default"
    ],
    "semanticFileSuffixes": [
      "service",
      "api",
      "util",
      "config",
      "types",
      "interface",
      "store",
      "hook",
      "slice",
      "schema",
      "converters",
      "handlers",
      "mock"
    ]
  },
  "hookFilePattern": "^use-[a-z0-9-]+\\.tsx?$",
  "suffixes": {
    "schema": ".schema.ts",
    "converters": ".converters.ts",
    "api": ".service.ts",
    "handlers": ".handlers.ts",
    "mock": ".mock.ts",
    "config": ".config.ts"
  }
}
